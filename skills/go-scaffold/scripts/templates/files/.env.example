PORT=8090
GIN_MODE=debug

# Comma-separated allowlist for middleware.CORS(). "*" allows every origin —
# don't use it here; this API sends an Authorization header.
CORS_ORIGINS={{CORS}}

DB_HOST=localhost
# Host-side port from docker-compose.yml. Deliberately not 5432: that's the port
# every other Postgres on the machine also wants.
DB_PORT=5454
DB_USER={{DB_SLUG}}
DB_PASSWORD={{DB_SLUG}}
DB_NAME={{DB_SLUG}}
DB_SSLMODE=disable

# No default — main() refuses to start without it. Generate one:
#   openssl rand -base64 48
JWT_SECRET=
ACCESS_TOKEN_EXPIRY_MINUTES=15
REFRESH_TOKEN_EXPIRY_DAYS=7
