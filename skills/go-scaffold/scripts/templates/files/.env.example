PORT=8090
GIN_MODE=debug

# Comma-separated CORS allowlist, resolved at startup and passed to the CORS
# middleware. "*" refuses to boot: responses go out with credentials allowed and
# browsers carry the session cookie, so a wildcard would let any site read a
# logged-in user's data.
CORS_ORIGINS={{CORS}}

DB_HOST=localhost
# Host-side port from docker-compose.yml. Deliberately not 5432: that's the port
# every other Postgres on the machine also wants.
DB_PORT=5454
DB_USER={{DB_SLUG}}
DB_PASSWORD={{DB_SLUG}}
DB_NAME={{DB_SLUG}}
DB_SSLMODE=disable

# No default — config.Load() refuses to start without it. Generate one:
#   openssl rand -base64 48
JWT_SECRET=
ACCESS_TOKEN_EXPIRY_MINUTES=15
REFRESH_TOKEN_EXPIRY_DAYS=7

# Browser sessions (POST /api/v1/auth/session). Comma-separated origins of the
# web app(s) allowed to use the session cookie for anything that changes state —
# the CSRF allowlist. Separate from CORS_ORIGINS on purpose. Empty means every
# cookie mutation (login included) is refused with 403; "*" refuses to boot.
WEB_ORIGINS={{CORS}}
SESSION_IDLE_HOURS=72
SESSION_ABSOLUTE_DAYS=30
# true: cookie "__Host-session", Secure. false: cookie "session" over plain
# HTTP, for local development only — the server logs a warning at boot.
# Browsers treat http://localhost as secure, so true works there too.
SESSION_COOKIE_SECURE=true
