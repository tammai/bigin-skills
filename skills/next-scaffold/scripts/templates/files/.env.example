# iron-session sealed-cookie secret, 32+ chars (generate one: openssl rand -base64 32)
# Used by src/lib/session.ts — required by the /api/backend proxy and (in the
# saas template) the login/signup/logout routes.
SESSION_PASSWORD=
# Backend REST API origin (server-only; never exposed to the browser). The
# /api/backend/* proxy and the auth routes forward here. Point it at a running
# go-scaffold backend — origin only, e.g. http://localhost:8090 (go-scaffold's
# default PORT). The API's /api/v1 base path comes from the backend's
# middleware.BaseURL: if it changes, change baseUrl in
# src/shared/api-client/index.ts and API_PREFIX in src/lib/backend.ts with it.
BACKEND_URL=
