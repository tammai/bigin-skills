import type { Component } from 'vue'
import Hero from '~/components/blocks/Hero.vue'

// The block registry. `blocks[].type` in a content entry is data written by a
// content editor, so it is resolved through this map rather than turned into a
// component name string: an unknown type renders nothing, the same way a
// missing locale does, instead of throwing on a client's live site.
//
// Adding a block type is three changes in one commit — the component, an entry
// here, and the collection schema. Never a hand-written key the renderer does
// not know.
const BLOCKS: Record<string, Component> = {
  hero: Hero
}

// `Object.hasOwn` rather than a bare index: `type` is data a content editor
// wrote, and every object literal inherits `constructor`, `__proto__`,
// `toString` and the rest from `Object.prototype`. A bare lookup returns those
// — truthy, and not a component — so the signature below would be lying and
// `<component :is>` would receive `Object` for `type: constructor`. The guard
// lives in the function rather than in a null-prototype `BLOCKS`, because the
// function is what makes the promise: a later edit rewriting the literal back
// to `{ … }` cannot silently take this away.
export function blockFor(type: string): Component | undefined {
  return Object.hasOwn(BLOCKS, type) ? BLOCKS[type] : undefined
}
