import { z } from 'zod'

const Body = z.object({
  email: z.email(),
  turnstileToken: z.string().min(1)
})

export default defineEventHandler(async (event) => {
  const body = Body.parse(await readBody(event))
  await verifyTurnstile(event, body.turnstileToken)
  await rateLimit(event, { key: `newsletter:${getRequestIP(event, { xForwardedFor: true })}`, max: 5, windowSec: 3600 })
  await subscribe(event, body.email)
  return { ok: true }
})
